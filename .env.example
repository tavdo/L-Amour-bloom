# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=L'Amour Bloom
NEXT_PUBLIC_STORE_NAME_KA=სიყვარულის ყვავილობა

# Node locally must be >= 20.9 (Vercel default for this stack)
# Database — Neon (Vercel Marketplace) in production.
# Locally you can use Postgres on localhost (see .env.local after first migrate).
# DATABASE_URL: pooled Neon URL (hostname contains "-pooler") or local Postgres
# DATABASE_URL_UNPOOLED: direct URL for Prisma CLI / migrations
# Vercel Neon also injects POSTGRES_URL / POSTGRES_URL_NON_POOLING — those work too.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Admin seed (used by `npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Session
SESSION_SECRET=

# Vercel Blob (product image uploads). Local catalog uses placeholder images if unset.
BLOB_READ_WRITE_TOKEN=

# Payments: "live" | "mock"
# mock = local checkout without bank credentials (do not use in production)
PAYMENTS_MODE=mock

# Bank of Georgia Online Payments API
# Sandbox: https://api.bog.ge/docs/en/sandbox/payments/introduction
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=
BOG_API_BASE_URL=https://api.bog.ge
BOG_OAUTH_URL=https://oauth2.bog.ge/auth/realms/bog/protocol/openid-connect/token
# Official callback public key is in BOG docs; override if the bank issues a different key.
BOG_CALLBACK_PUBLIC_KEY=

# TBC E-Commerce / Tpay
# Docs: https://developers.tbcbank.ge/docs/checkout-api-overview
TBC_API_BASE_URL=https://api.tbcbank.ge
TBC_API_KEY=
TBC_CLIENT_ID=
TBC_CLIENT_SECRET=
# Optional comma-separated callback IP allowlist (TBC documents these IPs)
TBC_CALLBACK_IPS=193.104.20.44,193.104.20.45,185.52.80.44,185.52.80.45
